---
// Özgeçmiş: ekranda sitenin koyu temasında, yazdırırken A4 tek sayfa, açık zemin.
// İçerik sitenin geri kalanıyla aynı kaynaktan gelir; PDF bu sayfadan üretilir (scripts/build-cv-pdf.mjs).
import { getCv, getProjects } from '../content';
import { CONTACT } from '../content/types';
import type { Locale } from '../i18n/locales';
import { pathFor } from '../i18n/routes';
import { getUi } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const cv = getCv(locale);
const ui = getUi(locale);
const projects = getProjects(locale);
const siteUrl = new URL(pathFor('home', locale), Astro.site);
const absolute = (path: string) => new URL(path, Astro.site).href;
const bare = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<article class="cv">
  <header class="cv-head">
    <div>
      <h1>{CONTACT.name}</h1>
      <p class="cv-headline">{cv.headline}</p>
    </div>
    <ul class="cv-contact">
      <li>{cv.location} · {cv.remoteNote}</li>
      <li><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></li>
      <li><a href={siteUrl.href}>{bare(siteUrl.href)}</a></li>
      <li><a href={CONTACT.githubUrl}>{bare(CONTACT.githubUrl)}</a></li>
    </ul>
    <a class="cv-download" href={cv.pdfFile} download>
      {cv.downloadPdf}
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
        <path d="M12 4v12M6 11l6 6 6-6M5 20h14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"></path>
      </svg>
    </a>
  </header>

  <section>
    <h2>{cv.summaryHeading}</h2>
    <p>{cv.summary}</p>
  </section>

  <section>
    <h2>{cv.experienceHeading}</h2>
    <div class="cv-entry">
      <h3>{cv.experience.title}</h3>
      <p class="cv-meta">{cv.experience.place} · {cv.experience.period}</p>
      <ul class="cv-points">
        {cv.experience.points.map((point) => <li>{point}</li>)}
      </ul>
    </div>
  </section>

  <section>
    <h2>{cv.projectsHeading}</h2>
    <p class="cv-meta">{cv.projectsNote}</p>
    <ul class="cv-projects">
      {
        projects.map((project) => (
          <li>
            <h3>
              <a href={absolute(pathFor(project.id, locale))}>{project.title}</a>
            </h3>
            <p>{project.summary}</p>
            <p class="cv-url">{bare(absolute(pathFor(project.id, locale)))}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <div class="cv-columns">
    <section>
      <h2>{cv.educationHeading}</h2>
      <div class="cv-entry">
        <h3>{cv.education.degree}</h3>
        <p class="cv-meta">{cv.education.school} · {cv.education.year}</p>
      </div>
      <h2 class="cv-gap">{cv.languagesHeading}</h2>
      <ul class="cv-plain">
        {
          cv.languages.map((language) => (
            <li>
              {language.name} <span class="cv-meta">({language.level})</span>
            </li>
          ))
        }
      </ul>
    </section>
    <section>
      <h2>{cv.skillsHeading}</h2>
      <dl class="cv-skills">
        {
          cv.skills.map((skill) => (
            <div>
              <dt>{skill.label}</dt>
              <dd>{skill.items}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>
  <p class="cv-foot">{ui.footerNote}</p>
</article>

<style is:global>
  .cv {
    display: grid;
    gap: 2.5rem;
    max-width: 56rem;
    margin-inline: auto;
    padding: 7rem 1.25rem 5rem;
  }

  .cv-head {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-line);
  }

  .cv h1 {
    font-size: clamp(2.25rem, 1.6rem + 3vw, 3.5rem);
    font-variation-settings: 'opsz' 144;
  }

  .cv-headline {
    max-width: 44ch;
    margin-top: 0.75rem;
    color: var(--color-ink-soft);
    font-size: 1.0625rem;
  }

  .cv-contact {
    display: grid;
    gap: 0.25rem;
    font-size: 0.9375rem;
  }

  .cv-contact a,
  .cv-projects a {
    text-decoration-color: var(--color-line);
  }

  .cv-contact a:hover,
  .cv-projects a:hover {
    color: var(--color-accent);
  }

  .cv-download {
    display: inline-flex;
    gap: 0.625rem;
    align-items: center;
    min-height: 3rem;
    padding-inline: 1.25rem;
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    font-weight: 500;
    text-decoration: none;
  }

  .cv-download:hover {
    background-color: var(--color-accent);
    color: var(--color-ground);
  }

  .cv h2 {
    margin-bottom: 0.75rem;
    color: var(--color-accent);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0;
  }

  .cv h3 {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.35;
  }

  .cv p,
  .cv li,
  .cv dd {
    max-width: 68ch;
  }

  .cv-meta,
  .cv-url,
  .cv-foot {
    color: var(--color-ink-soft);
    font-size: 0.9375rem;
  }

  .cv-url {
    display: none;
  }

  .cv-points {
    display: grid;
    gap: 0.375rem;
    margin-top: 0.625rem;
    padding-left: 1.125rem;
    list-style: square;
  }

  .cv-points li::marker {
    color: var(--color-accent);
  }

  .cv-projects {
    display: grid;
    gap: 1rem;
    margin-top: 0.875rem;
  }

  .cv-projects p {
    margin-top: 0.125rem;
  }

  .cv-columns {
    display: grid;
    gap: 2.5rem;
  }

  .cv-gap {
    margin-top: 1.75rem;
  }

  .cv-skills {
    display: grid;
    gap: 0.625rem;
  }

  .cv-skills dt {
    font-weight: 600;
  }

  .cv-foot {
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
  }

  @media (min-width: 640px) {
    .cv {
      padding: 9rem 2rem 6rem;
    }

    .cv-columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 3rem;
    }
  }

  /* Yazdırma ve PDF: A4, tek sayfa, açık zemin, koyu metin. Site başlığı, alt bilgi ve efektler çıkmaz. */
  @page {
    size: A4;
    margin: 14mm 16mm;
  }

  @media print {
    html,
    body {
      background: #fff !important;
      color: #16181d !important;
    }

    body::before,
    body::after,
    body > header,
    body > footer,
    .skip-link,
    .cursor-light,
    .cv-download,
    .cv-foot {
      display: none !important;
    }

    .cv {
      gap: 5mm;
      max-width: none;
      padding: 0;
      font-size: 9.6pt;
      line-height: 1.42;
    }

    .cv-head {
      grid-template-columns: 1fr auto;
      gap: 6mm;
      align-items: end;
      padding-bottom: 4mm;
      border-color: #c9ccd3;
    }

    /* Harf aralığı sıfırlanır ve kelime aralığı açılır: PDF metin katmanında ad kelime kelime okunsun (başvuru sistemleri için). */
    .cv h1 {
      font-size: 24pt;
      letter-spacing: 0;
      word-spacing: 0.12em;
    }

    .cv-headline {
      margin-top: 1.5mm;
      font-size: 10pt;
    }

    .cv-contact {
      gap: 0.5mm;
      font-size: 9pt;
      text-align: right;
    }

    .cv h2 {
      margin-bottom: 1.5mm;
      color: #9a5a12;
      font-size: 8.6pt;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .cv h3 {
      font-size: 10.4pt;
    }

    .cv p,
    .cv li,
    .cv dd {
      max-width: none;
    }

    .cv-headline,
    .cv-meta,
    .cv-url {
      color: #50545e !important;
      font-size: 9pt;
    }

    .cv-url {
      display: block;
    }

    .cv a {
      color: inherit;
      text-decoration: none;
    }

    .cv-points {
      gap: 0.8mm;
      margin-top: 1.5mm;
    }

    .cv-points li::marker {
      color: #9a5a12;
    }

    .cv-projects {
      gap: 2.2mm;
      margin-top: 2mm;
    }

    .cv-columns {
      grid-template-columns: 1fr 1.25fr;
      gap: 8mm;
    }

    .cv-gap {
      margin-top: 4mm;
    }

    .cv-skills {
      gap: 1.2mm;
    }

    .cv section {
      break-inside: avoid;
    }
  }
</style>
