---
interface Props {
  tags: readonly string[];
  label: string;
}

const { tags, label } = Astro.props;
---

<ul class="tech-tags" aria-label={label} lang="en">
  {tags.map((tag) => <li>{tag}</li>)}
</ul>

<style>
  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    line-height: 1.4;
    color: var(--color-ink-soft);
  }

  .tech-tags li:not(:last-child)::after {
    content: '';
    display: inline-block;
    width: 0.25rem;
    height: 0.25rem;
    margin-left: 1.25rem;
    border-radius: 50%;
    background-color: var(--color-line);
    vertical-align: middle;
  }
</style>
