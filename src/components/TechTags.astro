---
interface Props {
  tags: readonly string[];
  label: string;
}

const { tags, label } = Astro.props;
---

<ul class="tech-tags" aria-label={label} lang="en">
  {tags.map((tag) => <li>{tag}</li>)}
</ul>

<style>
  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    line-height: 1.4;
    color: var(--color-ink-soft);
  }

</style>
