---
import type { Locale } from '../i18n/locales';
import { pathFor, type PageId } from '../i18n/routes';
import { getUi } from '../i18n/ui';
import LangSwitch from './LangSwitch.astro';

interface Props {
  page: PageId | 'notFound';
  locale: Locale;
}

const { page, locale } = Astro.props;
const ui = getUi(locale);
---

<header class="absolute inset-x-0 top-0 z-50">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 sm:px-8">
    <a class="inline-flex min-h-11 items-center text-[0.9375rem] font-medium text-ink no-underline hover:text-accent" href={pathFor('home', locale)}>
      {ui.siteName}
    </a>
    <LangSwitch page={page} locale={locale} />
  </div>
</header>
