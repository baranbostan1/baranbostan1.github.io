---
// Ana sayfadaki proje bölümü: görüntü + bir cümle sorun, bir cümle sonuç, etiketler ve proje sayfasına bağlantı.
import { getHome } from '../../content';
import type { ProjectContent } from '../../content/types';
import type { Locale } from '../../i18n/locales';
import { pathFor } from '../../i18n/routes';
import { getUi } from '../../i18n/ui';
import ArrowLink from '../ArrowLink.astro';
import Scene from '../Scene.astro';
import TechTags from '../TechTags.astro';

interface Props {
  project: ProjectContent;
  locale: Locale;
  sceneAlt: string;
  /** Görüntünün metnin hangi yanında duracağı (geniş ekranda) */
  mediaSide?: 'start' | 'end';
  /** Bölüm kendi görünür başlığının altındaysa 3 verilir; görünüm aynı kalır */
  headingLevel?: 2 | 3;
}

const { project, locale, sceneAlt, mediaSide = 'start', headingLevel = 2 } = Astro.props;
const ui = getUi(locale);
const home = getHome(locale);
const headingId = `proje-${project.id}`;
const Heading = headingLevel === 3 ? 'h3' : 'h2';
// Konsept çalışma gerçek kullanım iddia etmez: "Sorun / Sonuç" yerine "Senaryo / Ne gösteriyor" yazılır.
const isConcept = project.kind === 'concept';
const problemLabel = isConcept ? ui.scenarioLabel : ui.problemLabel;
const resultLabel = isConcept ? ui.showsLabel : ui.resultLabel;
---

<section class="project" data-media-side={mediaSide} aria-labelledby={headingId}>
  <div class="project-media-frame" data-tilt>
    <Scene name={project.id} locale={locale} alt={sceneAlt} class="project-media" />
  </div>
  <div class="project-body">
    <div class="project-title">
      <Heading id={headingId} class="project-heading">{project.title}</Heading>
      {isConcept && <p class="concept-badge">{ui.conceptBadge}</p>}
    </div>
    <dl>
      <div>
        <dt>{problemLabel}</dt>
        <dd>{project.sceneProblem}</dd>
      </div>
      <div>
        <dt>{resultLabel}</dt>
        <dd>{project.sceneResult}</dd>
      </div>
    </dl>
    <slot />
    <TechTags tags={project.tags} label={ui.technicalLabel} />
    <ArrowLink href={pathFor(project.id, locale)} label={`${home.projectCta}: ${project.title}`}>{home.projectCta}</ArrowLink>
  </div>
</section>

<style>
  .project {
    display: grid;
    gap: 2rem;
    max-width: 80rem;
    margin-inline: auto;
    padding: 4rem 1.25rem;
  }

  .project :global(.project-media) {
    aspect-ratio: 16 / 10;
  }

  .project-media-frame {
    align-self: center;
    transition: transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  .project-body {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 1.75rem;
  }

  .project-title {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    align-items: baseline;
  }

  .concept-badge {
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    font-size: 0.9375rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .project-heading {
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.5rem);
    /* Hero ve İletişim başlıklarıyla aynı kesim. */
    font-variation-settings: 'opsz' 144;
  }

  dl {
    display: grid;
    gap: 1.25rem;
    max-width: 44ch;
  }

  dt {
    color: var(--color-accent);
    font-size: 0.875rem;
    font-weight: 600;
  }

  dd {
    margin-top: 0.25rem;
    font-size: 1.125rem;
    line-height: 1.5;
  }

  @media (min-width: 640px) {
    .project {
      padding: 6rem 2rem;
    }
  }

  @media (min-width: 1024px) {
    .project {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 4.5rem;
      padding-block: 8rem;
    }

    .project[data-media-side='end'] {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }

    .project[data-media-side='end'] .project-media-frame {
      order: 2;
    }
  }
</style>
