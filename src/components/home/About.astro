---
import { getHome } from '../../content';
import type { Locale } from '../../i18n/locales';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { about } = getHome(locale);
---

<section class="about" aria-labelledby="hakkimda">
  <div class="about-head">
    <h2 id="hakkimda">{about.heading}</h2>
    <p class="about-lead">{about.lead}</p>
    <div class="about-edu">
      <h3>{about.educationHeading}</h3>
      <p>{about.education}</p>
    </div>
  </div>
  <dl class="about-skills">
    {
      about.skills.map((skill) => (
        <div>
          <dt>{skill.title}</dt>
          <dd>{skill.text}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .about {
    display: grid;
    gap: 3rem;
    max-width: 80rem;
    margin-inline: auto;
    padding: 5rem 1.25rem;
    border-top: 1px solid var(--color-line);
  }

  h2 {
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.5rem);
    /* Hero ve İletişim başlıklarıyla aynı kesim. */
    font-variation-settings: 'opsz' 144;
  }

  .about-lead {
    max-width: 46ch;
    margin-top: 1.25rem;
    font-size: 1.125rem;
    line-height: 1.55;
  }

  .about-edu {
    margin-top: 2.5rem;
  }

  .about-edu h3 {
    color: var(--color-accent);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0;
  }

  .about-edu p {
    max-width: 40ch;
    margin-top: 0.375rem;
  }

  .about-skills {
    display: grid;
    gap: 2.25rem 3rem;
  }

  dt {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.15;
  }

  dd {
    max-width: 42ch;
    margin-top: 0.625rem;
    color: var(--color-ink);
  }

  @media (min-width: 640px) {
    .about {
      padding: 7rem 2rem;
    }

    .about-skills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .about {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 4.5rem;
      padding-block: 9rem;
    }
  }
</style>
