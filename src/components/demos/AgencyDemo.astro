---
// Acenta fatura ve ödeme takibi demosu. Sunucuda başlangıç verisinin özeti ve bakiye tablosu çizilir;
// betik yüklenince form, filtre, sıralama ve kayıt listesi çalışır. Veri yalnızca tarayıcıda durur.
import { formatKurus } from '../../demos/agency/amount';
import { agencyBalances, AGENCY_NAME_MAX_LENGTH, summarize } from '../../demos/agency/ledger';
import { SEED } from '../../demos/agency/seed';
import { AGENCY_STRINGS } from '../../demos/agency/strings';
import type { Locale } from '../../i18n/locales';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = AGENCY_STRINGS[locale];
const money = (kurus: number) => formatKurus(kurus, locale);
const totals = summarize(SEED);
const balances = agencyBalances(SEED);
---

<div class="ag-demo" data-agency-demo data-locale={locale}>
  <p class="ag-note">{s.fictionalNote}</p>
  <p class="ag-note ag-note-warn" data-memory-note hidden>{s.memoryOnlyNote}</p>

  {/* Ad listeye değil gruba verilir: dl'nin erişilebilir adı her ekran okuyucuda okunmaz. */}
  <div role="group" aria-label={s.summaryLabel}>
  <dl class="ag-summary" data-summary>
    <div><dt>{s.totalInvoiced}</dt><dd>{money(totals.invoicedKurus)}</dd></div>
    <div><dt>{s.totalPaid}</dt><dd>{money(totals.paidKurus)}</dd></div>
    <div><dt>{s.openBalance}</dt><dd>{money(totals.balanceKurus)}</dd></div>
  </dl>
  </div>

  <div class="ag-main">
    <form class="ag-form" data-form novalidate>
      <h3>{s.formHeading}</h3>
      <fieldset class="ag-kind">
        <legend class="sr-only">{s.typeLabel}</legend>
        <label><input type="radio" name="kind" value="invoice" checked /><span>{s.invoice}</span></label>
        <label><input type="radio" name="kind" value="payment" /><span>{s.payment}</span></label>
      </fieldset>

      <div class="ag-field">
        <label for={`ag-agency-${locale}`}>{s.agencyLabel}</label>
        <input
          id={`ag-agency-${locale}`}
          name="agency"
          type="text"
          list={`ag-agencies-${locale}`}
          maxlength={AGENCY_NAME_MAX_LENGTH}
          autocomplete="off"
          aria-describedby={`ag-agency-hint-${locale} ag-agency-error-${locale}`}
        />
        <datalist id={`ag-agencies-${locale}`} data-agency-options>
          {balances.map((row) => <option value={row.agency} />)}
        </datalist>
        <p class="ag-hint" id={`ag-agency-hint-${locale}`}>{s.agencyHint}</p>
        <p class="ag-error" id={`ag-agency-error-${locale}`} data-error="agency" hidden></p>
      </div>

      <div class="ag-row">
        <div class="ag-field">
          <label for={`ag-date-${locale}`}>{s.dateLabel}</label>
          <input id={`ag-date-${locale}`} name="date" type="date" aria-describedby={`ag-date-error-${locale}`} />
          <p class="ag-error" id={`ag-date-error-${locale}`} data-error="date" hidden></p>
        </div>
        <div class="ag-field" data-field="invoiceNo">
          <label for={`ag-no-${locale}`}>{s.invoiceNoLabel}</label>
          <input id={`ag-no-${locale}`} name="invoiceNo" type="text" maxlength="30" autocomplete="off" aria-describedby={`ag-no-error-${locale}`} />
          <p class="ag-error" id={`ag-no-error-${locale}`} data-error="invoiceNo" hidden></p>
        </div>
      </div>

      <div class="ag-field">
        <label for={`ag-amount-${locale}`}>{s.amountLabel}</label>
        <input
          id={`ag-amount-${locale}`}
          name="amount"
          type="text"
          inputmode="decimal"
          autocomplete="off"
          aria-describedby={`ag-amount-hint-${locale} ag-amount-error-${locale}`}
        />
        <p class="ag-hint" id={`ag-amount-hint-${locale}`}>{s.amountHint}</p>
        <p class="ag-error" id={`ag-amount-error-${locale}`} data-error="amount" hidden></p>
      </div>

      <button type="submit" class="ag-submit">{s.submitInvoice}</button>
      <p class="ag-status" data-status role="status" aria-live="polite"></p>
    </form>

    <section class="ag-balances" aria-labelledby={`ag-balances-${locale}`}>
      <h3 id={`ag-balances-${locale}`}>{s.balancesHeading}</h3>
      <table class="ag-table" role="table">
        <thead role="rowgroup">
          <tr role="row">
            <th role="columnheader" scope="col">{s.colAgency}</th>
            <th role="columnheader" scope="col" class="ag-num">{s.colInvoiced}</th>
            <th role="columnheader" scope="col" class="ag-num">{s.colPaid}</th>
            <th role="columnheader" scope="col" class="ag-num">{s.colBalance}</th>
          </tr>
        </thead>
        <tbody data-balances role="rowgroup">
          {
            balances.map((row) => (
              <tr role="row">
                <th role="rowheader" scope="row">{row.agency}</th>
                <td role="cell" class="ag-num" data-label={s.colInvoiced}>{money(row.invoicedKurus)}</td>
                <td role="cell" class="ag-num" data-label={s.colPaid}>{money(row.paidKurus)}</td>
                <td class="ag-num ag-balance" data-label={s.colBalance}>
                  {money(row.balanceKurus)}
                  {row.balanceKurus < 0 && <span class="ag-tag">{s.credit}</span>}
                  {row.balanceKurus === 0 && <span class="ag-tag">{s.settled}</span>}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>
  </div>

  <section class="ag-records" aria-labelledby={`ag-records-${locale}`}>
    <div class="ag-records-head">
      <h3 id={`ag-records-${locale}`}>{s.recordsHeading}</h3>
      <div class="ag-controls">
        <label>
          <span>{s.filterLabel}</span>
          <select data-filter>
            <option value="">{s.allAgencies}</option>
          </select>
        </label>
        <label>
          <span>{s.sortLabel}</span>
          <select data-sort>
            <option value="newest">{s.sortNewest}</option>
            <option value="oldest">{s.sortOldest}</option>
            <option value="largest">{s.sortLargest}</option>
          </select>
        </label>
      </div>
    </div>
    <div class="ag-scroll" data-lenis-prevent tabindex="0" role="region" aria-labelledby={`ag-records-${locale}`}>
      <table class="ag-table ag-table-records" role="table">
        <thead role="rowgroup">
          <tr role="row">
            <th role="columnheader" scope="col">{s.colDate}</th>
            <th role="columnheader" scope="col">{s.colType}</th>
            <th role="columnheader" scope="col">{s.colAgency}</th>
            <th role="columnheader" scope="col">{s.colInvoiceNo}</th>
            <th role="columnheader" scope="col" class="ag-num">{s.colAmount}</th>
          </tr>
        </thead>
        <tbody data-records role="rowgroup"></tbody>
      </table>
    </div>
    <div class="ag-actions">
      <button type="button" class="ag-button" data-export>{s.exportCsv}</button>
      <button type="button" class="ag-button ag-button-quiet" data-reset>{s.reset}</button>
    </div>
  </section>
</div>

<script>
  import { initAgencyDemo } from '../../demos/agency/ui';

  document.querySelectorAll<HTMLElement>('[data-agency-demo]').forEach((root) => {
    try {
      initAgencyDemo(root);
    } catch (error) {
      // Betik çalışmazsa sunucuda çizilen özet ve bakiye tablosu görünmeye devam eder.
      console.error('[acenta]', error);
    }
  });
</script>

<style is:global>
  .ag-demo {
    display: grid;
    gap: 2.5rem;
  }

  .ag-demo h3 {
    font-size: 1.5rem;
  }

  .ag-note {
    color: var(--color-ink-soft);
  }

  .ag-note-warn {
    margin-top: -1.75rem;
    color: var(--color-accent);
  }

  .ag-summary {
    display: grid;
    gap: 1.25rem 3rem;
    padding-block: 1.5rem;
    border-block: 1px solid var(--color-line);
  }

  .ag-summary dt {
    color: var(--color-ink-soft);
    font-size: 0.9375rem;
  }

  .ag-summary dd {
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: clamp(1.25rem, 1rem + 1vw, 1.625rem);
    font-variant-numeric: tabular-nums;
  }

  .ag-main {
    display: grid;
    gap: 3rem;
    align-items: start;
  }

  .ag-form {
    display: grid;
    gap: 1.25rem;
  }

  .ag-kind {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 0.1875rem;
    border: 1px solid var(--color-line);
  }

  .ag-kind label {
    position: relative;
    display: grid;
    cursor: pointer;
  }

  .ag-kind input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }

  .ag-kind span {
    display: grid;
    place-items: center;
    min-height: 2.75rem;
    color: var(--color-ink-soft);
    font-weight: 500;
  }

  .ag-kind input:checked + span {
    background-color: var(--color-accent);
    color: var(--color-ground);
  }

  .ag-kind input:focus-visible + span {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .ag-row {
    display: grid;
    gap: 1.25rem;
  }

  .ag-field {
    display: grid;
    gap: 0.375rem;
    align-content: start;
  }

  .ag-field label,
  .ag-controls span {
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .ag-field input,
  .ag-controls select {
    width: 100%;
    min-height: 2.875rem;
    padding-inline: 0.875rem;
    border: 1px solid var(--color-line);
    border-radius: 0;
    background-color: var(--color-surface);
    color: var(--color-ink);
    font-size: 1rem;
    caret-color: var(--color-accent);
    color-scheme: dark;
  }

  .ag-field input:hover,
  .ag-controls select:hover {
    border-color: var(--color-ink-soft);
  }

  .ag-field input[aria-invalid='true'] {
    border-color: var(--color-danger);
  }

  .ag-hint {
    color: var(--color-ink-soft);
    font-size: 0.875rem;
  }

  .ag-error {
    color: var(--color-danger);
    font-size: 0.9375rem;
  }

  .ag-submit,
  .ag-button {
    min-height: 3rem;
    padding-inline: 1.5rem;
    border: 1px solid var(--color-accent);
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color 200ms cubic-bezier(0.16, 1, 0.3, 1),
      color 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ag-submit {
    justify-self: start;
    background-color: var(--color-accent);
    color: var(--color-ground);
  }

  .ag-submit:hover {
    background-color: var(--color-ink);
    border-color: var(--color-ink);
  }

  .ag-button {
    color: var(--color-accent);
  }

  .ag-button:hover {
    background-color: var(--color-accent);
    color: var(--color-ground);
  }

  .ag-button-quiet {
    border-color: var(--color-line);
    color: var(--color-ink);
  }

  .ag-button-quiet:hover {
    border-color: var(--color-ink);
    background-color: var(--color-ink);
  }

  .ag-status {
    min-height: 1.5rem;
    color: var(--color-ink-soft);
  }

  .ag-table {
    width: 100%;
    margin-top: 1rem;
    border-collapse: collapse;
    text-align: left;
  }

  .ag-table th,
  .ag-table td {
    padding: 0.75rem 0.75rem 0.75rem 0;
    border-bottom: 1px solid var(--color-line);
    vertical-align: baseline;
  }

  /* Başlıklar veri değil etikettir: sayı sütunlarının başlığı da gövde fontuyla yazılır. */
  .ag-table thead th {
    color: var(--color-ink-soft);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .ag-table tbody th {
    font-weight: 500;
  }

  .ag-num {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
    text-align: right;
    white-space: nowrap;
  }

  .ag-table .ag-num:last-child {
    padding-right: 0;
  }

  .ag-mono {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
  }

  .ag-date {
    white-space: nowrap;
  }

  .ag-tag {
    display: block;
    color: var(--color-ink-soft);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
  }

  .ag-table tr[data-touched] {
    animation: ag-touch 1600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes ag-touch {
    from {
      background-color: oklch(0.74 0.13 62 / 0.22);
    }

    to {
      background-color: transparent;
    }
  }

  .ag-records-head {
    display: grid;
    gap: 1.25rem;
  }

  .ag-controls {
    display: grid;
    gap: 1rem;
  }

  .ag-controls label {
    display: grid;
    gap: 0.375rem;
  }

  .ag-scroll {
    max-height: 26rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--color-line) transparent;
  }

  .ag-table-records thead th {
    position: sticky;
    top: 0;
    background-color: var(--color-ground);
  }

  .ag-empty {
    padding-block: 2rem;
    color: var(--color-ink-soft);
  }

  .ag-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  /* Dar ekranda tablolar satır başına bir karta dönüşür; yatay kaydırma olmaz. */
  @media (max-width: 639px) {
    .ag-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }

    .ag-table tr {
      display: grid;
      gap: 0.25rem;
      padding-block: 0.875rem;
      border-bottom: 1px solid var(--color-line);
    }

    .ag-table th,
    .ag-table td {
      display: flex;
      gap: 1rem;
      justify-content: space-between;
      padding: 0;
      border: 0;
      text-align: right;
    }

    .ag-table tbody th {
      justify-content: flex-start;
      font-size: 1.0625rem;
      text-align: left;
    }

    .ag-table td[data-label]::before {
      content: attr(data-label);
      color: var(--color-ink-soft);
      font-family: var(--font-sans);
      font-size: 0.875rem;
      text-align: left;
    }

    .ag-tag {
      display: inline;
      margin-left: 0.5rem;
    }
  }

  @media (min-width: 640px) {
    .ag-summary {
      grid-template-columns: repeat(3, auto);
      justify-content: start;
    }

    .ag-row,
    .ag-controls {
      grid-template-columns: 1fr 1fr;
    }

    .ag-records-head {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }

  @media (min-width: 1024px) {
    .ag-main {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 4.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ag-table tr[data-touched] {
      animation: none;
      background-color: oklch(0.74 0.13 62 / 0.14);
    }

    .ag-submit,
    .ag-button {
      transition: none;
    }
  }
</style>
