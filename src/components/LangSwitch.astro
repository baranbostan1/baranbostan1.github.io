---
import type { Locale } from '../i18n/locales';
import { alternateFor, type PageId } from '../i18n/routes';
import { getUi } from '../i18n/ui';

interface Props {
  page: PageId | 'notFound';
  locale: Locale;
}

const { page, locale } = Astro.props;
const ui = getUi(locale);
// 404 sayfasının karşılığı yoktur; diğer dilin ana sayfasına gider.
const target = page === 'notFound' ? alternateFor('home', locale) : alternateFor(page, locale);
---

<a
  class="inline-flex min-h-11 items-center gap-2 text-[0.9375rem] font-medium text-ink no-underline hover:text-accent"
  href={target.path}
  hreflang={target.locale}
>
  <span aria-hidden="true" class="text-ink-soft">{locale.toUpperCase()} /</span>
  <span lang={target.locale}>{ui.switchLanguageName}</span>
</a>
