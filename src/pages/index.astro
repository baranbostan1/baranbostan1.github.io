---
import About from '../components/home/About.astro';
import BalanceTicker from '../components/home/BalanceTicker.astro';
import Contact from '../components/home/Contact.astro';
import Hero from '../components/home/Hero.astro';
import HowIWork from '../components/home/HowIWork.astro';
import LiveStrip from '../components/home/LiveStrip.astro';
import ProjectScene from '../components/home/ProjectScene.astro';
import { getConceptProjects, getHome, getProjects } from '../content';
import { CONTACT } from '../content/types';
import { getUi } from '../i18n/ui';
import Base from '../layouts/Base.astro';

const locale = 'tr';
const home = getHome(locale);
const ui = getUi(locale);
const projects = getProjects(locale);
const conceptProjects = getConceptProjects(locale);
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: CONTACT.name,
  email: `mailto:${CONTACT.email}`,
  url: new URL('/', Astro.site).href,
  sameAs: [CONTACT.githubUrl],
};
---

<Base page="home" locale={locale} title={home.metaTitle} description={home.metaDescription}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(person)} />
  <Hero locale={locale} sceneAlt={home.hero.sceneAlt} />
  <div id="projeler">
    <h2 class="sr-only">{ui.projectsHeading}</h2>
    {
      projects.map((project, index) => (
        <ProjectScene project={project} locale={locale} sceneAlt={project.sceneAlt} mediaSide={index % 2 === 0 ? 'start' : 'end'}>
          {project.id === 'lobby' && <LiveStrip locale={locale} />}
          {project.id === 'agency' && <BalanceTicker locale={locale} />}
        </ProjectScene>
      ))
    }
  </div>
  <section class="concept" id="konsept" aria-labelledby="konsept-baslik">
    <div class="concept-head">
      <h2 id="konsept-baslik">{ui.conceptHeading}</h2>
      <p>{ui.conceptLead}</p>
    </div>
    {conceptProjects.map((project) => <ProjectScene project={project} locale={locale} sceneAlt={project.sceneAlt} headingLevel={3} />)}
  </section>
  <HowIWork locale={locale} />
  <About locale={locale} />
  <Contact locale={locale} />
</Base>

<style>
  .concept {
    border-top: 1px solid var(--color-line);
  }

  .concept-head {
    max-width: 80rem;
    margin-inline: auto;
    padding: 5rem 1.25rem 0;
  }

  /* Bölüm başlığı ile sahne arasında tam bölüm boşluğu fazla gelir. */
  .concept :global(.project) {
    padding-top: 3rem;
  }

  .concept-head h2 {
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.5rem);
    /* Hero ve İletişim başlıklarıyla aynı kesim. */
    font-variation-settings: 'opsz' 144;
  }

  .concept-head p {
    max-width: 48ch;
    margin-top: 1.25rem;
    font-size: 1.125rem;
    line-height: 1.55;
  }

  @media (min-width: 640px) {
    .concept-head {
      padding-inline: 2rem;
    }
  }
</style>
