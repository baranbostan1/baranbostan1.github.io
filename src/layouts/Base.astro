---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { DEFAULT_LOCALE, LOCALES, type Locale } from '../i18n/locales';
import { pathFor, type PageId } from '../i18n/routes';
import { getUi } from '../i18n/ui';

interface Props {
  page: PageId | 'notFound';
  locale: Locale;
  title: string;
  description: string;
  ogImage?: string;
  /** false ise site başlığı ve alt bilgi çizilmez (tam ekran demo sayfaları) */
  chrome?: boolean;
  noindex?: boolean;
}

const { page, locale, title, description, ogImage, chrome = true, noindex = false } = Astro.props;
const ui = getUi(locale);
const absolute = (path: string) => new URL(path, Astro.site).href;
const isRealPage = page !== 'notFound';
const canonical = isRealPage ? absolute(pathFor(page, locale)) : undefined;
const alternates = isRealPage ? LOCALES.map((code) => ({ code, href: absolute(pathFor(page, code)) })) : [];
const defaultHref = isRealPage ? absolute(pathFor(page, DEFAULT_LOCALE)) : undefined;
const OG_LOCALES: Record<Locale, string> = { tr: 'tr_TR', en: 'en_US' };
const OG_IMAGE_SIZE = { width: 1200, height: 630 };
// Sayfa kendi görselini vermediyse dile göre ortak paylaşım görseli kullanılır.
const shareImage = absolute(ogImage ?? `/og/og-${locale}.jpg`);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0e14" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.code} href={alt.href} />)}
    {defaultHref && <link rel="alternate" hreflang="x-default" href={defaultHref} />}
    {(!isRealPage || noindex) && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={ui.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={OG_LOCALES[locale]} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content={String(OG_IMAGE_SIZE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE_SIZE.height)} />
    <meta property="og:image:alt" content={ui.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* Sayfa çizilmeden önce çalışır: hangi karenin görüneceği buna bağlıdır. Mantık src/cinematic/mode.ts ile aynıdır. */}
    <script is:inline>
      (function () {
        try {
          var m = window.matchMedia;
          var c = navigator.connection;
          var still = m('(prefers-reduced-motion: reduce)').matches || !!(c && c.saveData);
          var rich = m('(min-width: 1024px)').matches && m('(hover: hover) and (pointer: fine)').matches;
          document.documentElement.dataset.cine = still ? 'static' : rich ? 'scrub' : 'play';
          // Asıl betik yüklenemezse (ağ hatası, engelleyici) sahneler "önceki hâl"de kalmasın: son karelere dönülür.
          window.setTimeout(function () {
            if (!document.documentElement.hasAttribute('data-cine-ready')) document.documentElement.dataset.cine = 'static';
          }, 6000);
        } catch (e) {}
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#icerik">{ui.skipToContent}</a>
    {chrome && <Header page={page} locale={locale} />}
    <main id="icerik" tabindex="-1">
      <slot />
    </main>
    {chrome && <Footer locale={locale} />}
    <script>
      import { initCinematic } from '../cinematic';
      initCinematic();
    </script>
  </body>
</html>
