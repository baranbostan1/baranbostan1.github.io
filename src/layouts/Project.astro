---
// Proje sayfalarının ortak yapısı: başlık ve özet → Problem → Çözüm → Demo → Teknik → Sonuç.
import TechTags from '../components/TechTags.astro';
import { getProject } from '../content';
import type { ProjectId } from '../content/types';
import type { Locale } from '../i18n/locales';
import QRCode from 'qrcode';
import { demoPageFor, pathFor } from '../i18n/routes';
import { getUi } from '../i18n/ui';
import Base from './Base.astro';

interface Props {
  id: ProjectId;
  locale: Locale;
  /** true ise tam ekran demonun QR kodu gösterilir (telefonda denenmesi anlamlı olan demolar) */
  showQr?: boolean;
}

const { id, locale, showQr = false } = Astro.props;
const ui = getUi(locale);
const project = getProject(id, locale);
const demoPath = pathFor(demoPageFor(id), locale);
const demoUrl = new URL(demoPath, Astro.site).href;
// Kod derleme sırasında üretilir; açık zemin üstünde koyu kareler her kamerada okunur.
const qrSvg = showQr ? await QRCode.toString(demoUrl, { type: 'svg', margin: 2, errorCorrectionLevel: 'M', color: { dark: '#0b0e14', light: '#f1ece4' } }) : null;
---

<Base page={id} locale={locale} title={`${project.title} — ${ui.siteName}`} description={project.summary}>
  <article class="project-page">
    <header class="page-head">
      <a class="back" href={`${pathFor('home', locale)}#projeler`}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
          <path d="M20 12H5M11 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"></path>
        </svg>
        {ui.backToHome}
      </a>
      <h1>{project.title}</h1>
      <p class="summary">{project.summary}</p>
      <TechTags tags={project.tags} label={ui.technicalLabel} />
    </header>

    <div class="pair">
      <section aria-labelledby="problem">
        <h2 id="problem">{ui.problemLabel}</h2>
        <p>{project.problem}</p>
      </section>
      <section aria-labelledby="cozum">
        <h2 id="cozum">{ui.solutionLabel}</h2>
        <p>{project.solution}</p>
      </section>
    </div>

    <section class="demo" aria-labelledby="demo">
      <h2 id="demo">{ui.demoLabel}</h2>
      <p class="note">{project.demoNote}</p>
      <slot name="demo" />
      <div class="demo-extra">
        {
          qrSvg && (
            <div class="demo-qr">
              <div class="demo-qr-code" role="img" aria-label={ui.scanHeading} set:html={qrSvg} />
              <div>
                <h3>{ui.scanHeading}</h3>
                <p>{ui.scanText}</p>
              </div>
            </div>
          )
        }
        <a class="demo-full-link" href={demoPath}>
          {ui.openFullscreenDemo}
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
            <path d="M4 12h15M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"></path>
          </svg>
        </a>
      </div>
    </section>

    <div class="pair">
      <section aria-labelledby="teknik">
        <h2 id="teknik">{ui.technicalLabel}</h2>
        <ul class="tech-list">
          {project.technical.map((item) => <li>{item}</li>)}
        </ul>
      </section>
      <section aria-labelledby="sonuc">
        <h2 id="sonuc">{ui.resultLabel}</h2>
        <p>{project.outcome}</p>
      </section>
    </div>

    <slot />
  </article>
</Base>

<style>
  .project-page {
    max-width: 80rem;
    margin-inline: auto;
    padding: 7rem 1.25rem 5rem;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    color: var(--color-ink-soft);
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .back:hover {
    color: var(--color-accent);
  }

  h1 {
    margin-top: 1.5rem;
    font-size: clamp(2.75rem, 1.6rem + 5vw, 5rem);
    font-variation-settings: 'opsz' 144;
  }

  .summary {
    max-width: 48ch;
    margin-block: 1.5rem 2rem;
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    line-height: 1.5;
  }

  .pair {
    display: grid;
    gap: 3rem;
    margin-top: 5rem;
    padding-top: 3rem;
    border-top: 1px solid var(--color-line);
  }

  h2 {
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 2rem);
  }

  .pair p,
  .tech-list {
    max-width: 62ch;
    margin-top: 1rem;
    color: var(--color-ink);
  }

  .tech-list {
    display: grid;
    gap: 0.75rem;
    padding-left: 1.125rem;
    list-style: square;
  }

  .tech-list li::marker {
    color: var(--color-accent);
  }

  .demo {
    margin-top: 5rem;
    padding-top: 3rem;
    border-top: 1px solid var(--color-line);
  }

  .demo-extra {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    margin-top: 3rem;
  }

  .demo-qr {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 1.5rem;
    align-items: center;
  }

  .demo-qr-code {
    width: 9.5rem;
    height: 9.5rem;
    flex: none;
  }

  .demo-qr-code :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .demo-qr h3 {
    font-size: 1.5rem;
  }

  .demo-qr p {
    max-width: 34ch;
    margin-top: 0.5rem;
    color: var(--color-ink-soft);
  }

  .demo-full-link {
    display: inline-flex;
    gap: 0.625rem;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-accent);
    font-weight: 500;
    text-decoration: none;
  }

  .demo-full-link:hover {
    text-decoration: underline;
  }

  .note {
    max-width: 62ch;
    margin-block: 1rem 2rem;
    color: var(--color-ink-soft);
  }

  @media (min-width: 640px) {
    .project-page {
      padding: 9rem 2rem 7rem;
    }
  }

  @media (min-width: 900px) {
    .pair {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 4.5rem;
    }
  }
</style>
