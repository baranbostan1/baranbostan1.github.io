---
// Bir demonun çerçevesiz, tam ekran sayfası. Üstte yalnızca ince bir şerit vardır:
// proje sayfasına dönüş ve dil değiştirici. Arama motorlarına kapalıdır; asıl içerik proje sayfasındadır.
import LangSwitch from '../components/LangSwitch.astro';
import { getProject } from '../content';
import type { Locale } from '../i18n/locales';
import { demoPageFor, pathFor, type ProjectPageId } from '../i18n/routes';
import { getUi } from '../i18n/ui';
import Base from './Base.astro';

interface Props {
  id: ProjectPageId;
  locale: Locale;
  /** true ise içerik kenar boşluğu olmadan ekranı doldurur (telefonda açılan menü gibi) */
  flush?: boolean;
}

const { id, locale, flush = false } = Astro.props;
const ui = getUi(locale);
const project = getProject(id, locale);
const page = demoPageFor(id);
---

<Base page={page} locale={locale} title={`${project.title} · ${ui.fullscreenDemoTitle} — ${ui.siteName}`} description={project.demoNote} chrome={false} noindex>
  <div class="demo-page">
    <div class="demo-bar">
      <a class="demo-back" href={pathFor(id, locale)}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
          <path d="M20 12H5M11 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"></path>
        </svg>
        <span>{ui.backToProject}</span>
      </a>
      <LangSwitch page={page} locale={locale} />
    </div>
    <h1 class="sr-only">{project.title} · {ui.fullscreenDemoTitle}</h1>
    {/* Demolar proje sayfasında bir h2'nin altında durur ve h3 ile başlar; burada da başlık sırası atlamasın. */}
    <h2 class="sr-only">{ui.demoLabel}</h2>
    <div class:list={['demo-body', { 'demo-body-flush': flush }]}>
      <slot />
    </div>
  </div>
</Base>

<style>
  .demo-page {
    display: grid;
    grid-template-rows: auto 1fr;
    min-height: 100svh;
  }

  .demo-bar {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    padding: 0.25rem 1.25rem;
    border-bottom: 1px solid var(--color-line);
  }

  .demo-back {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-ink-soft);
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .demo-back:hover {
    color: var(--color-accent);
  }

  .demo-body {
    width: 100%;
    max-width: 80rem;
    margin-inline: auto;
    padding: 2rem 1.25rem 4rem;
  }

  .demo-body-flush {
    max-width: none;
    padding: 0;
  }

  @media (min-width: 640px) {
    .demo-bar {
      padding-inline: 2rem;
    }

    .demo-body:not(.demo-body-flush) {
      padding-inline: 2rem;
    }
  }
</style>
